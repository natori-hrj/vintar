{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/natori-hrj/vintar/blob/main/schemas/regression-batch-report-v1.schema.json",
  "title": "Vintar Regression Batch Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "status",
    "complete",
    "exit_code",
    "planned_case_ids",
    "executed_case_ids",
    "not_run_case_ids",
    "planned_count",
    "executed_count",
    "requests_used",
    "counts",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "regression_batch"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "complete": {
      "type": "boolean"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        3
      ]
    },
    "planned_case_ids": {
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation": {
                "properties": { "status": { "const": "not_eligible" } },
                "required": ["status"]
              }
            },
            "required": ["confirmation"]
          },
          "then": {
            "properties": {
              "verification": {
                "not": { "$ref": "#/$defs/eligible_initial" }
              }
            }
          }
        },
        {
          "$ref": "#/$defs/identifiers"
        },
        {
          "minItems": 1
        }
      ]
    },
    "executed_case_ids": {
      "allOf": [
        {
          "$ref": "#/$defs/identifiers"
        },
        {
          "minItems": 1
        }
      ]
    },
    "not_run_case_ids": {
      "$ref": "#/$defs/identifiers"
    },
    "planned_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "executed_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "requests_used": {
      "$ref": "#/$defs/count"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "inconclusive",
        "not_run"
      ],
      "properties": {
        "pass": {
          "$ref": "#/$defs/count"
        },
        "fail": {
          "$ref": "#/$defs/count"
        },
        "inconclusive": {
          "$ref": "#/$defs/count"
        },
        "not_run": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "inconclusive"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "not_run_case_ids": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "enum": [
              "fail",
              "inconclusive"
            ]
          },
          "not_run_case_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "identifiers": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "verdict": {
      "enum": [
        "vulnerable",
        "not_detected",
        "inconclusive"
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_verdict",
        "actual_verdict",
        "expectation_match",
        "status"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "check_type": {
          "enum": [
            "sqli.time",
            "sqli.error"
          ]
        },
        "expected_verdict": {
          "$ref": "#/$defs/verdict"
        },
        "actual_verdict": {
          "$ref": "#/$defs/verdict"
        },
        "actual_reason_code": {
          "$ref": "#/$defs/final_reason"
        },
        "request_count": {
          "$ref": "#/$defs/count"
        },
        "expectation_match": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "decision_facts": {
          "$ref": "#/$defs/decision_facts"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check_type": { "const": "sqli.time" }
            },
            "required": ["check_type"]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/time_outcome"
              }
            ],
            "required": [
              "actual_reason_code",
              "request_count",
              "timing"
            ],
            "not": {
              "anyOf": [
                { "required": ["verification"] },
                { "required": ["confirmation"] },
                { "required": ["error"] }
              ]
            }
          },
          "else": {
            "if": {
              "properties": {
                "check_type": { "const": "sqli.error" }
              },
              "required": ["check_type"]
            },
            "then": {
              "$ref": "#/$defs/error_outcome",
              "required": [
                "actual_reason_code",
                "request_count",
                "error"
              ],
              "not": {
                "anyOf": [
                  { "required": ["verification"] },
                  { "required": ["confirmation"] },
                  { "required": ["timing"] }
                ]
              }
            },
            "else": {
              "required": [
                "verification"
              ],
              "dependentRequired": {
                "actual_reason_code": [
                  "request_count",
                  "confirmation"
                ],
                "request_count": [
                  "actual_reason_code",
                  "confirmation"
                ],
                "confirmation": [
                  "actual_reason_code",
                  "request_count"
                ]
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "actual_reason_code": { "const": "unstable_timing" }
                },
                "required": ["actual_reason_code"]
              },
              {
                "properties": {
                  "decision_facts": {
                    "properties": { "category": { "const": "timing_dynamics" } },
                    "required": ["category"]
                  }
                },
                "required": ["decision_facts"]
              }
            ]
          },
          "then": {
            "properties": {
              "decision_facts": {
                "required": ["instability_causes"],
                "not": {
                  "anyOf": [
                    { "required": ["candidate_median_met"] },
                    { "required": ["candidate_margin_met"] },
                    { "required": ["no_delay_condition_met"] }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "actual_reason_code": { "const": "ambiguous_timing" }
                },
                "required": ["actual_reason_code"]
              },
              {
                "properties": {
                  "decision_facts": {
                    "properties": { "category": { "const": "timing_dynamics" } },
                    "required": ["category"]
                  }
                },
                "required": ["decision_facts"]
              }
            ]
          },
          "then": {
            "properties": {
              "decision_facts": {
                "required": [
                  "candidate_median_met",
                  "candidate_margin_met",
                  "no_delay_condition_met"
                ],
                "properties": {
                  "instability_causes": { "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_facts": {
                "properties": { "category": { "const": "operational" } },
                "required": ["category"]
              }
            },
            "required": ["decision_facts"]
          },
          "then": {
            "properties": {
              "actual_reason_code": {
                "enum": [
                  "budget_unavailable", "probe_failed", "rate_limited",
                  "truncated_response", "non_success_status",
                  "incomplete_probes", "probe_timeout", "probe_interrupted",
                  "confirmation_budget_unavailable", "confirmation_preflight_failed",
                  "confirmation_budget_exceeded", "confirmation_rate_limit_interrupted",
                  "confirmation_timeout", "confirmation_request_failed",
                  "confirmation_rate_limited", "confirmation_truncated",
                  "confirmation_non_success_status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_facts": {
                "properties": { "category": { "const": "timing_dynamics" } },
                "required": ["category"]
              }
            },
            "required": ["decision_facts"]
          },
          "then": {
            "properties": {
              "actual_reason_code": {
                "enum": ["unstable_timing", "ambiguous_timing"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_facts": {
                "properties": { "category": { "const": "response_dynamics" } },
                "required": ["category"]
              }
            },
            "required": ["decision_facts"]
          },
          "then": {
            "properties": {
              "actual_reason_code": {
                "enum": ["possible_dynamic_response", "unstable_response"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_facts": {
                "properties": { "category": { "const": "confirmation_relation" } },
                "required": ["category"]
              }
            },
            "required": ["decision_facts"]
          },
          "then": {
            "properties": {
              "actual_reason_code": {
                "enum": ["confirmation_unstable", "candidate_confirmation_mismatch", "confirmation_cross_phase_mismatch"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation": {
                "properties": {
                  "status": {
                    "const": "matched"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "confirmation"
            ]
          },
          "then": {
            "properties": {
              "actual_verdict": {
                "const": "inconclusive"
              },
              "actual_reason_code": {
                "const": "boolean_candidate"
              },
              "request_count": {
                "const": 18
              },
              "verification": {
                "$ref": "#/$defs/eligible_initial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation": {
                "properties": {
                  "status": {
                    "const": "mismatch"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "confirmation"
            ]
          },
          "then": {
            "properties": {
              "actual_verdict": {
                "const": "inconclusive"
              },
              "actual_reason_code": {
                "const": "candidate_confirmation_mismatch"
              },
              "request_count": {
                "const": 18
              },
              "verification": {
                "$ref": "#/$defs/eligible_initial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation": {
                "properties": {
                  "status": {
                    "const": "operational"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "confirmation"
            ]
          },
          "then": {
            "properties": {
              "actual_verdict": {
                "const": "inconclusive"
              },
              "actual_reason_code": {
                "$ref": "#/$defs/operational_reason"
              },
              "verification": {
                "$ref": "#/$defs/eligible_initial"
              }
            }
          }
        }
      ]
    },
    "decision_facts": {
      "oneOf": [
        { "$ref": "#/$defs/operational_decision_facts" },
        { "$ref": "#/$defs/response_dynamics_decision_facts" },
        { "$ref": "#/$defs/confirmation_relation_decision_facts" },
        { "$ref": "#/$defs/timing_dynamics_decision_facts" }
      ]
    },
    "operational_decision_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "stage", "sequence", "probe_kind", "condition"],
      "properties": {
        "category": { "const": "operational" },
        "stage": { "enum": ["initial", "confirmation", "time", "error"] },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 18 },
        "probe_kind": {
          "enum": ["baseline", "true", "false", "control", "delay", "error", "true_1", "false_1", "true_2", "false_2", "baseline_preserving_control"]
        },
        "condition": {
          "enum": ["timeout", "connection", "response_read", "budget_exceeded", "rate_limit", "cancelled", "unknown", "budget_unavailable", "preflight_failed", "rate_limit_interrupted", "rate_limited", "truncated", "non_success_status", "request_failed", "interrupted", "deadline"]
        },
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "unstable_pair_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_kind", "localization"],
      "properties": {
        "probe_kind": { "enum": ["baseline", "true", "false"] },
        "localization": { "enum": ["localized", "unlocalized"] },
        "prefix_size": { "$ref": "#/$defs/count" },
        "suffix_size": { "$ref": "#/$defs/count" },
        "first_changed_size": { "$ref": "#/$defs/count" },
        "second_changed_size": { "$ref": "#/$defs/count" }
      },
      "allOf": [
        {
          "if": { "properties": { "localization": { "const": "localized" } } },
          "then": { "required": ["prefix_size", "suffix_size", "first_changed_size", "second_changed_size"] },
          "else": { "not": { "anyOf": [
            { "required": ["prefix_size"] }, { "required": ["suffix_size"] },
            { "required": ["first_changed_size"] }, { "required": ["second_changed_size"] }
          ] } }
        }
      ]
    },
    "response_dynamics_decision_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "normalization_applied", "normalized_echo_count", "unstable_pairs"],
      "properties": {
        "category": { "const": "response_dynamics" },
        "normalization_applied": { "type": "boolean" },
        "normalized_echo_count": { "$ref": "#/$defs/count" },
        "unstable_pairs": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "$ref": "#/$defs/unstable_pair_facts" }
        }
      }
    },
    "confirmation_relation_decision_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "unstable_repeat_kinds", "unreproduced_predicate_pairs", "mismatched_relations", "cross_phase_mismatched_kinds"],
      "properties": {
        "category": { "const": "confirmation_relation" },
        "unstable_repeat_kinds": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["baseline", "true_1", "false_1", "baseline_preserving_control", "true_2", "false_2"] }
        },
        "unreproduced_predicate_pairs": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["true", "false"] }
        },
        "mismatched_relations": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["baseline_true", "baseline_control", "baseline_false"] }
        },
        "cross_phase_mismatched_kinds": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["baseline", "true", "false"] }
        }
      }
    },
    "timing_dynamics_decision_facts": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "instability_causes"],
          "properties": {
            "category": { "const": "timing_dynamics" },
            "instability_causes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["baseline_span", "control_span", "baseline_control_difference", "drift", "delay_span"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "instability_causes", "candidate_median_met", "candidate_margin_met", "no_delay_condition_met"],
          "properties": {
            "category": { "const": "timing_dynamics" },
            "instability_causes": { "type": "array", "maxItems": 0 },
            "candidate_median_met": { "type": "boolean" },
            "candidate_margin_met": { "type": "boolean" },
            "no_delay_condition_met": { "type": "boolean" }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "request_count"],
      "properties": {
        "status": {
          "enum": ["matched", "not_matched", "inconclusive"]
        },
        "reason_code": {
          "enum": [
            "dbms_error_disclosed",
            "dbms_error_not_observed",
            "baseline_dbms_error",
            "unstable_response",
            "unstable_error_signal",
            "ambiguous_dbms_error",
            "non_success_status",
            "truncated_response",
            "probe_timeout",
            "probe_failed",
            "probe_interrupted",
            "rate_limited"
          ]
        },
        "request_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "dbms": {
          "type": "string"
        },
        "signature_id": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason_code": { "const": "dbms_error_disclosed" } },
            "required": ["reason_code"]
          },
          "then": {
            "allOf": [
              { "required": ["dbms", "signature_id"] },
              { "$ref": "#/$defs/error_signature_pairs" }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["dbms"] },
                { "required": ["signature_id"] }
              ]
            }
          }
        }
      ]
    },
    "error_signature_pairs": {
      "oneOf": [
        {
          "properties": {
            "dbms": {
              "const": "mssql"
            },
            "signature_id": {
              "enum": [
                "mssql_syntax_error"
              ]
            }
          },
          "required": [
            "dbms",
            "signature_id"
          ]
        },
        {
          "properties": {
            "dbms": {
              "const": "mysql"
            },
            "signature_id": {
              "enum": [
                "mysql_syntax_error_1064"
              ]
            }
          },
          "required": [
            "dbms",
            "signature_id"
          ]
        },
        {
          "properties": {
            "dbms": {
              "const": "oracle"
            },
            "signature_id": {
              "enum": [
                "oracle_syntax_error"
              ]
            }
          },
          "required": [
            "dbms",
            "signature_id"
          ]
        },
        {
          "properties": {
            "dbms": {
              "const": "postgresql"
            },
            "signature_id": {
              "enum": [
                "postgresql_syntax_error"
              ]
            }
          },
          "required": [
            "dbms",
            "signature_id"
          ]
        },
        {
          "properties": {
            "dbms": {
              "const": "sqlite"
            },
            "signature_id": {
              "enum": [
                "sqlite_operational_syntax"
              ]
            }
          },
          "required": [
            "dbms",
            "signature_id"
          ]
        }
      ]
    },
    "error_outcome": {
      "allOf": [
        {
          "oneOf": [
            { "$ref": "#/$defs/error_disclosed" },
            { "$ref": "#/$defs/error_not_observed" },
            { "$ref": "#/$defs/error_complete_inconclusive" },
            { "$ref": "#/$defs/error_operational" }
          ]
        },
        {
          "if": { "properties": { "request_count": { "const": 1 } } },
          "then": { "properties": { "error": { "properties": { "request_count": { "const": 1 } } } } }
        },
        {
          "if": { "properties": { "request_count": { "const": 2 } } },
          "then": { "properties": { "error": { "properties": { "request_count": { "const": 2 } } } } }
        },
        {
          "if": { "properties": { "request_count": { "const": 3 } } },
          "then": { "properties": { "error": { "properties": { "request_count": { "const": 3 } } } } }
        },
        {
          "if": { "properties": { "request_count": { "const": 4 } } },
          "then": { "properties": { "error": { "properties": { "request_count": { "const": 4 } } } } }
        },
        {
          "if": { "required": ["decision_facts"] },
          "then": {
            "properties": {
              "decision_facts": {
                "properties": {
                  "category": { "const": "operational" },
                  "stage": { "const": "error" },
                  "sequence": { "type": "integer", "minimum": 1, "maximum": 4 },
                  "probe_kind": { "enum": ["baseline", "error"] }
                }
              }
            }
          }
        }
      ]
    },
    "error_disclosed": {
      "type": "object",
      "properties": {
        "actual_verdict": { "const": "inconclusive" },
        "actual_reason_code": { "const": "dbms_error_disclosed" },
        "request_count": { "const": 4 },
        "error": {
          "type": "object",
          "properties": {
            "status": { "const": "matched" },
            "reason_code": { "const": "dbms_error_disclosed" },
            "request_count": { "const": 4 }
          }
        }
      }
    },
    "error_not_observed": {
