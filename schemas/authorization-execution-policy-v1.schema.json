{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vintar.dev/schemas/authorization-execution-policy-v1.schema.json",
  "title": "Vintar Authorization Execution Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_type", "identities", "approvals", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_type": {"const": "authorization_execution"},
    "identities": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["identity_id", "authentication"], "properties": {"identity_id": {"$ref": "#/$defs/alias"}, "authentication": {"const": "none"}}},
      {"type": "object", "additionalProperties": false, "required": ["identity_id", "authentication", "credential_kind", "env_var", "header_name"], "properties": {"identity_id": {"$ref": "#/$defs/alias"}, "authentication": {"const": "required"}, "credential_kind": {"enum": ["bearer", "api_key_header", "basic"]}, "env_var": {"type": "string", "minLength": 1, "maxLength": 128}, "header_name": {"type": "string", "minLength": 1, "maxLength": 128}, "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}}}
    ]}},
    "approvals": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "case_sha256", "origin", "environment_class", "operations"], "properties": {"case_id": {"$ref": "#/$defs/alias"}, "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "origin": {"type": "string", "minLength": 1, "maxLength": 2048}, "environment_class": {"$ref": "#/$defs/alias"}, "operations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["operation_id", "identity_id", "method", "path", "expected"], "properties": {"operation_id": {"$ref": "#/$defs/alias"}, "identity_id": {"$ref": "#/$defs/alias"}, "method": {"const": "GET"}, "path": {"type": "string", "minLength": 1, "maxLength": 2048}, "expected": {"enum": ["allow", "deny"]}}}}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_requests", "max_requests_per_second", "max_timeout_seconds", "max_response_size"], "properties": {"max_requests": {"type": "integer", "minimum": 1, "maximum": 256}, "max_requests_per_second": {"type": "number", "minimum": 0.1, "maximum": 10}, "max_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 60}, "max_response_size": {"type": "integer", "minimum": 1, "maximum": 1048576}}}
  },
  "$defs": {"alias": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_-]+$"}}
}
