{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/natori-hrj/vintar/blob/main/schemas/authorization-case-v1.schema.json",
  "title": "Vintar Authorization Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "type", "category", "environment_class", "identities", "operations"],
  "properties": {
    "version": {"const": 1},
    "id": {"$ref": "#/$defs/alias"},
    "type": {"const": "authorization.access"},
    "category": {"enum": ["idor", "bola", "bfla", "horizontal_escalation", "vertical_escalation", "broken_access_control", "tenant_isolation", "unauthenticated_access"]},
    "environment_class": {"$ref": "#/$defs/alias"},
    "identities": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "authentication"],
        "properties": {
          "id": {"$ref": "#/$defs/alias"},
          "label": {"$ref": "#/$defs/alias"},
          "authentication": {"enum": ["required", "none"]}
        }
      }
    },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "identity_id", "resource_id", "control", "expected", "request", "assertions"],
        "properties": {
          "id": {"$ref": "#/$defs/alias"},
          "identity_id": {"$ref": "#/$defs/alias"},
          "resource_id": {"$ref": "#/$defs/alias"},
          "control": {"enum": ["positive", "negative"]},
          "expected": {"enum": ["allow", "deny"]},
          "request": {"$ref": "#/$defs/request"},
          "assertions": {"$ref": "#/$defs/assertions"}
        }
      }
    }
  },
  "$defs": {
    "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "maxLength": 64},
    "pointer": {"type": "string", "maxLength": 512, "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "url", "allowed_origin"],
      "properties": {
        "method": {"const": "GET"},
        "url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "allowed_origin": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "assertions": {
      "type": "object", "additionalProperties": false,
      "required": ["status_codes", "required_json_pointers", "forbidden_json_pointers", "allow_empty_body"],
      "properties": {
        "status_codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "media_type": {"const": "application/json"},
        "required_json_pointers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}},
        "forbidden_json_pointers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}},
        "allow_empty_body": {"type": "boolean"}
      }
    }
  }
}
